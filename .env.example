# Copy to .env — never commit .env
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Deployment only (set these in your host's dashboard, e.g. Render) ──
# APP_PASSWORD  — password to open the hosted dashboard (enables login)
# CV_TEXT       — your CV text (pipe-separated, see data/cv.txt) seeded on boot
# PORT          — provided automatically by the host
APP_PASSWORD=
CV_TEXT=
